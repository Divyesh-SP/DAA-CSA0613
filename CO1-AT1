import math

def cloud_backup(n):
    if n <= 1:
        return 1
    return 2 * cloud_backup(n // 2) + n * math.log2(n)

n = int(input("Enter the data size: "))

result = cloud_backup(n)

print("Estimated backup work:", round(result, 2))
print("Time Complexity: Θ(n (log n)^2)")

